[{"n":"Le Lude Petite Cité de Caractère","c":"Site culturel","la":47.64691,"lo":0.15685,"v":"Luché-Pringé","cp":"72800","maj":"2025-02-12","src":"https://data.datatourisme.fr/49/03e3b90e-5f44-373a-9d30-85f43a5feca0","d":"Haut lieu stratégique situé au carrefour du Maine, de l’Anjou et de la Touraine, la cité du Lude se mire dans le Loir. Célèbre pour son château et ses jardins, tout dans la cité rappelle le passé florissant de cette cité castrale et commerçante."},{"n":"Château du Lude","c":"Château et fortification","la":47.64752,"lo":0.15899,"v":"Le Lude","cp":"72800","maj":"2025-06-17","src":"https://data.datatourisme.fr/49/09a345bf-aea7-3dd4-b826-298c8a9d291b","d":"Le Lude, un château historique, une demeure habitée et vivante."},{"n":"Jardins du château du Lude","c":"Parc et jardin","la":47.64753,"lo":0.15931,"v":"Le Lude","cp":"72800","maj":"2025-03-07","src":"https://data.datatourisme.fr/49/17ea63e2-3829-3cc4-9855-4da43e59012b","d":"Le monument domine la vallée du Loir, et les jardins qui l'entourent ont été façonnés au fil des générations, mêlant harmonieusement les parterroises, es réguliers avec un parc à l'anglaise."},{"n":"Jardins du château de Lorrière","c":"Parc et jardin","la":47.60719,"lo":0.15527,"v":"Le Lude","cp":"72800","maj":"2025-01-01","src":"https://data.datatourisme.fr/49/c88357c6-95d8-33fc-8977-8759990a5643","d":"Le jardin à la française, conçu dans les années 1920, se noie, comme l'aimait l'architecte Jules Vacherot, dans le parc qui descend le long de la rivière."},{"n":"Commune fleurie de Dissé sous le Lude","c":"Site culturel","la":47.60829,"lo":0.15601,"v":"Le Lude","cp":"72800","maj":"2025-03-20","src":"https://data.datatourisme.fr/49/cd76db1b-4b34-36b4-80c8-dc392578890c"},{"n":"église St Martin de Luché","c":"Édifice religieux","la":47.6612,"lo":0.16207,"v":"Luché-Pringé","cp":"72800","maj":"2024-05-30","src":"https://data.datatourisme.fr/49/db937979-6287-3d66-9806-31462de00670","d":"Eglise St Martin (13e-16e)."},{"n":"Commune fleuri