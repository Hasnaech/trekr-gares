[{"n":"Eglise de Succieu","c":"Édifice religieux","la":45.52804,"lo":5.3388,"v":"Succieu","cp":"38300","maj":"2021-11-26","src":"https://data.datatourisme.fr/13/9a21abcd-b1c4-3e8f-aaa1-c8fb76811233"},{"n":"Médiathèque CAPI de Ruy-Montceau","c":"Bibliothèque","la":45.58765,"lo":5.31914,"v":"Ruy-Montceau","cp":"38300","maj":"2023-10-20","src":"https://data.datatourisme.fr/13/984cb72a-d72c-30bb-8662-b95aec0daf5d","d":"La médiathèque de Ruy-Montceau vous accueille le mardi, le mercredi et le samedi. Une large collection vous est proposée : livres, CD et abonnements."},{"n":"Ancienne usine-pensionnat au Vernay","c":"Patrimoine technique","la":45.56397,"lo":5.30424,"v":"Nivolas-Vermelle","cp":"38300","maj":"2021-11-30","src":"https://data.datatourisme.fr/13/975d8842-ad41-3aa8-897d-4109ca287185","d":"Ancien tissage, cet ensemble au Vernay est l'un des rares à conserver encore l'essentiel des bâtiments d'origine - de l'usine à la maison de maître - de ce type de site industriel (l'usine-pensionnat) autrefois courant en Nord-Dauphiné."},{"n":"Médiathèque de Saint-Victor-de-Cessieu","c":"Bibliothèque","la":45.54183,"lo":5.39379,"v":"Saint-Victor-de-Cessieu","cp":"38110","maj":"2024-10-01","src":"https://data.datatourisme.fr/13/018ac836-824e-37d1-9d34-a4628eff69e0","d":"Médiathèque du Réseau des Vals du Dauphiné"},{"n":"Eglise Saint-Denis de Ruy","c":"Édifice religieux","la":45.58793,"lo":5.31628,"v":"Ruy-Montceau","cp":"38300","maj":"2021-04-23","src":"https://data.datatourisme.fr/13/6f310fc9-0a8c-336e-ae59-31a4efaaf1c8"},{"n":"Eglise de Nivolas-Vermelle","c":"Édifice religieux","la":45.5589,"lo":5.3076,"v":"Nivolas-Vermelle","cp":"38300","maj":"2022-08-08","src":"https://data.datatourisme.fr/13/aedc73ba-34fd-314f-87e6-ffafd324f8c6"},{"n":"Eglise Saint-Augustin","c":"Édifice religieux","la":45.50805,"lo":5.30279,"v":"Eclose-Badinières","cp":"38300","maj":"2021-11-30","src":"https://data.datatourisme.fr/13/a8cd7f38-d5de-3f43-8d66-c445073e11d5","d":"Située au hameau des Trouillères, cette église d'inspiration néo-romane édifiée au milieu du XIXe siècle, contemporaine de la création de la commune de Badinières, résulte d'un juste équilibre entre plan à trois nefs et élancement des élévations."},{"n":"Eglise de Serezin-de-la-Tour","c":"Édifice religieux","la":45.55766,"lo":5.34502,"v":"Sérézin-de-la-Tour","cp":"38300","maj":"2021-04-23","src":"https://data.datatourisme.fr/13/cf7687f5-63cc-3002-9fdb-e0cb481919a4"},{"n":"Tour de l'Horloge","c":"Site culturel","la":45.56759,"lo":5.37669,"v":"Cessieu","cp":"38110","maj":"2025-06-23","src":"https://data.datatourisme.fr/13/dc597577-b4e3-33be-9fb9-893073f98fca","d":"Datant du 12e siècle et appartenant à la famille de Torchefelon, cette tour aurait joué un rôle de protection au Moyen-Age. Elle serait un vestige du « Châtelard » qui s’élevait à flanc de coteau."},{"n":"Eglise de Montceau","c":"Édifice religieux","la":45.58779,"lo":5.37474,"v":"Ruy-Montceau","cp":"38300","maj":"2021-04-23","src":"https://data.datatourisme.fr/13/3932f8b9-c8a3-378b-a9f0-1b58e322bc60"},{"n":"Médiathèque de Cessieu","c":"Bibliothèque","la":45.56687,"lo":5.37439,"v":"Cessieu","cp":"38110","maj":"2025-08-02","src":"https://data.datatourisme.fr/13/ec41888c-1d9c-3423-b380-6cdca96bda60","d":"Réseau des médiathèques des Vals du Dauphiné."},{"n":"Eglise de Châteauvilain","c":"Édifice religieux","la":45.5153,"lo":5.33003,"v":"Châteauvilain","cp":"38300","maj":"2021-04-23","src":"https://data.datatourisme.fr/13/2b3da88a-79ff-3eb4-92be-2727293bddf3"}]