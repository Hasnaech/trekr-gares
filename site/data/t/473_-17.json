[{"n":"CHÂTEAU DU HAUT GESVRES","c":"Château et fortification","la":47.32358,"lo":-1.62128,"v":"Treillières","cp":"44119","maj":"2023-09-27","src":"https://data.datatourisme.fr/49/9c8740cf-1372-311c-bc23-09e29f572dc8","d":"Construit en 1837, agrandi en 1867, le manoir de la Rivière, communément connu sous le nom de château du Haut-Gesvres, a vécu bien des péripéties. Il fut du temps de sa splendeur la résidence de propriétaires fortunés"},{"n":"CHAPELLE NOTRE-DAME-DES-FONTAINES","c":"Édifice religieux","la":47.36198,"lo":-1.61083,"v":"Grandchamp-des-Fontaines","cp":"44119","maj":"2025-05-17","src":"https://data.datatourisme.fr/49/6d0d1f25-45c3-3639-8735-37625730bf84","d":"La petite chapelle Notre-Dame-des-Fontaines est un pur modèle de simplicité."},{"n":"STÈLE AUX AVIATEURS","c":"Lieu de mémoire","la":47.35057,"lo":-1.6212,"v":"Grandchamp-des-Fontaines","cp":"44119","maj":"2025-05-17","src":"https://data.datatourisme.fr/49/1cc91760-a5eb-3c32-8b04-841924d871e2","d":"Stèle du souvenir"},{"n":"ÉGLISE NOTRE-DAME-DE-L'ASSOMPTION","c":"Édifice religieux","la":47.36509,"lo":-1.60563,"v":"Grandchamp-des-Fontaines","cp":"44119","maj":"2021-02-26","src":"https://data.datatourisme.fr/49/a06d1106-8b41-3fa6-a1ee-5d08716fb61f","d":"Construite au cours de la seconde moitié du XIXe siècle."},{"n":"CALVAIRE DU VALAIS","c":"Édifice religieux","la":47.3188,"lo":-1.68339,"v":"Vigneux-de-Bretagne","cp":"44360","maj":"2023-10-11","src":"https://data.datatourisme.fr/49/f7698094-ad18-3429-bcd7-e44094c34241","d":"Ce petit calvaire fut implanté en 1868 à la sortie sud du bourg de La Paquelais"},{"n":"ECOMUSEE RURAL DU PAYS NANTAIS : SITE DE LA PÂQUELAIS","c":"Site culturel","la":47.33366,"lo":-1.69649,"v":"Vigneux-de-Bretagne","cp":"44360","maj":"2025-08-05","src":"https://data.datatourisme.fr/49/d7b6bdfe-b651-3d7a-ace3-f402ce903535","d":"Musée qui expose tous types de matériels, outils, objets du monde rural… allant du 19è siècle au 20è siècle. ce musée organise aussi plusieurs expositions