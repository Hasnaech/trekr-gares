[{"n":"Lavoir","c":"Patrimoine technique","la":47.23862,"lo":4.82003,"v":"Gergueil","cp":"21410","maj":"2022-10-17","src":"https://data.datatourisme.fr/6/9a47a2eb-dae7-3249-8311-b8b24167b74a"},{"n":"Le Leuzeu","c":"Lieu de mémoire","la":47.27611,"lo":4.89204,"v":"Fleurey-sur-Ouche","cp":"21410","maj":"2024-12-31","src":"https://data.datatourisme.fr/6/62a439a0-9c8e-371d-b1bf-ce13f327e966","d":"Dès la préhistoire, les hommes sont présents au Leuzeu. Au Moyen-Age, on parle d’une grange monastique appartenant aux chanoines du château de Vergy, puis aux ducs de Bourgogne. A la Révolution, le domaine est vendu comme Bien National mais récupéré par Catherine Courtot de Cisse"},{"n":"Lavoir","c":"Patrimoine technique","la":47.27647,"lo":4.82747,"v":"Arcey","cp":"21410","maj":"2021-11-24","src":"https://data.datatourisme.fr/6/11474820-265f-342b-92d6-697c7ff4439b"},{"n":"Eglise Saint-Barbe","c":"Édifice religieux","la":47.24018,"lo":4.81735,"v":"Gergueil","cp":"21410","maj":"2022-10-20","src":"https://data.datatourisme.fr/6/1c9ec49b-3eae-375f-86d2-6df319abd52b"},{"n":"Eglise de la Nativité","c":"Édifice religieux","la":47.2747,"lo":4.82896,"v":"Arcey","cp":"21410","maj":"2022-10-20","src":"https://data.datatourisme.fr/6/4034a434-ce50-3d32-974a-fb9370bb84a3"}]