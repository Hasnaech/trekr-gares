[{"n":"Château d'eau","c":"Site culturel","la":43.65537,"lo":6.13221,"v":"Régusse","cp":"83630","maj":"2025-07-19","src":"https://data.datatourisme.fr/13/0e66fdcb-863a-3e91-8d44-a051525d6a07","d":"ll y a très peu d'eau à Régusse. Il n'y pas de fontaine ancienne à l'intérieur du village. Les Régussois du village stockaient l'eau qui venaient des toitures via les gouttières dans les caves (citernes dans le sol) à l'intérieur des habitations."},{"n":"Oratoire Saint-Eloy","c":"Site culturel","la":43.65243,"lo":6.141,"v":"Régusse","cp":"83630","maj":"2023-06-29","src":"https://data.datatourisme.fr/13/7465bea9-35e5-33fa-8503-f0cbef92695f","d":"Oratoire de Saint-Eloy"},{"n":"Oratoire Saint-Vincent de Paul","c":"Site culturel","la":43.65571,"lo":6.1329,"v":"Régusse","cp":"83630","maj":"2023-06-29","src":"https://data.datatourisme.fr/13/133c03cf-4e24-3c59-add9-f3633f7f6f5c","d":"Oratoire de Saint-Vincent de Paul"},{"n":"Musée de la Mémoire et du Souvenir","c":"Musée","la":43.65543,"lo":6.13211,"v":"Régusse","cp":"83630","maj":"2023-09-21","src":"https://data.datatourisme.fr/13/ae0f75c0-b16a-36bb-8363-0718d0662703","d":"Le musée de la mémoire et du souvenir des Anciens Combattants de Régusse vous propose une rétrospective des combats : 1914 - 1918, 1939 - 1945, Corée, Indochine, Afrique du Nord, Guerre du Golfe."},{"n":"Oratoire Sainte-Vierge","c":"Site culturel","la":43.65965,"lo":6.11913,"v":"Régusse","cp":"83630","maj":"2023-06-29","src":"https://data.datatourisme.fr/13/f30f1115-c4db-30fa-a947-c58e5fb57a0c","d":"Oratoire de la Sainte-Vierge"},{"n":"Oratoire Saint-Antoine","c":"Site culturel","la":43.65909,"lo":6.12295,"v":"Régusse","cp":"83630","maj":"2023-06-29","src":"https://data.datatourisme.fr/13/f867c419-7c56-35a2-956d-db4de9398cd8","d":"L'aratoire Saint-Antoine"},{"n":"Moulins à vent","c":"Patrimoine technique","la":43.65337,"lo":6.1323,"v":"Régusse","cp":"83630","maj":"2025-07-18","src":"https://data.datatourisme.fr/13/d1a8b671-d13b-3ab3-8725-10942896423c","d":"Les